{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --watch apps/cli/src/index.ts",
    "start": "bun apps/cli/src/index.ts",
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
