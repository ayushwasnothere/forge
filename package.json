{
  "name": "forge-code-ai",
  "version": "0.1.1",
  "type": "module",
  "bin": {
    "forge": "./dist/index.js"
  },
  "files": ["dist/index.js", "LICENSE", "README.md", "package.json"],
  "description": "A modular, terminal-first AI coding agent",
  "license": "MIT",
  "author": "Forge Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayushwasnothere/forge"
  },
  "keywords": ["ai", "coding-agent", "cli", "llm", "openai", "anthropic", "terminal"],
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepublishOnly": "bun run build",
    "dev": "bun --watch apps/cli/src/index.ts",
    "start": "bun apps/cli/src/index.ts",
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  }
}
