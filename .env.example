# ─── Provider ───────────────────────────────────────────────────
# Select one: openrouter, openai, anthropic, groq, grok, gemini, ollama
FORGE_PROVIDER=openrouter

# ─── API Key ────────────────────────────────────────────────────
# Required for all providers except Ollama
FORGE_API_KEY=replace_with_your_api_key

# ─── Model ──────────────────────────────────────────────────────
# Must support tool/function calling
FORGE_MODEL=anthropic/claude-sonnet-4

# ─── Base URL (optional) ────────────────────────────────────────
# Each provider has a sensible default. Override if using a proxy.
# FORGE_BASE_URL=https://openrouter.ai/api/v1
#
# Provider defaults:
#   openrouter  → https://openrouter.ai/api/v1
#   openai      → https://api.openai.com/v1
#   anthropic   → https://api.anthropic.com/v1
#   groq        → https://api.groq.com/openai/v1
#   grok        → https://api.x.ai/v1
#   gemini      → https://generativelanguage.googleapis.com/v1beta/openai
#   ollama      → http://localhost:11434/v1

# ─── Global Config (~/.forge/config.json) ─────────────────────
# For multi-provider & multi-model support, run `forge setup` or configure ~/.forge/config.json:
# {
#   "providers": {
#     "openrouter": { "apiKey": "sk-or-..." },
#     "groq": { "apiKey": "gsk-..." }
#   },
#   "models": {
#     "sonnet": { "provider": "openrouter", "model": "anthropic/claude-sonnet-4" },
#     "fast": { "provider": "groq", "model": "llama-3.3-70b-versatile" }
#   },
#   "defaultModel": "sonnet"
# }

